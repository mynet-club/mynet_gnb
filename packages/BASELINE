# GNB 发包基线 SSOT
#
# 本文件是「出厂 gnb」的唯一事实源。改基线/改补丁栈必须改这里，
# 脚本（scripts/gnb-dist.sh、scripts/apply_packages.sh）只读本文件。
# 知识库：core-remediation-plan-20260930.md 主线①。

# 上游基线（与 src/version、sources/history.ndjson 一致）
UPSTREAM_REPO=opengnb/opengnb
UPSTREAM_REF=1.6.8
UPSTREAM_COMMIT=c411f14ee647
SRC_VERSION=1.6.8
# 我们仓库中保存「未应用 MyNet 补丁」的对应提交
LOCAL_SOURCE_COMMIT=2313dea3288c98b363b2994c348452ef74cb7107
# 下面的提交是当前仓库发行/工具变更提交，不作为上游源码基线
LOCAL_REPO_HEAD=c8d7175

# 补丁栈（顺序固定，禁止用无 -v2 的 p1）
#   p1-hot-restart（v1）已废弃，只留档；出厂一律 p1-hot-restart-v2
PACKAGES_DIR=packages/1.6.8-c411f14ee647
PATCH_STACK=p1-hot-restart-v2,p2-route-proxy

# 幂等标记（apply_packages.sh / gnb-dist.sh 验收用）
#   P1: gnb_ctl_block.h 含 gnb_core_flag
#   P2: src/gnb_proxy_conf.h 含 gnb_proxy_cfg_t
MARK_P1_FILE=src/gnb_ctl_block.h
MARK_P1_TEXT=gnb_core_flag
MARK_P2_FILE=src/gnb_proxy_conf.h
MARK_P2_TEXT=gnb_proxy_cfg_t

# 出厂四程序（必须同一构建目录，禁止混用）
PROGRAMS=gnb,gnb_ctl,gnb_es,gnb_crypto

# 构建分工（core-remediation-plan §1.2）
#   开发编译: 本机 mac + 192.168.0.32
